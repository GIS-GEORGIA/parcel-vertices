{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "parcel-vertices-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-16",
  "observability": {
    "enabled": true,
    "traces": { "enabled": true }
  },
  "vars": {
    // "disabled" in production; "mock" only in .dev.vars for local testing. Switch to "flitt" / "keepz" once an adapter exists.
    "PAYMENT_PROVIDER": "disabled",
    "PUBLIC_BASE_URL": "https://parcel-vertices-api.kapanadze.workers.dev",
    "GOOGLE_CLIENT_ID": "951656446664-17dtvd8ouetdt4mfqmho9q67hv5886a4.apps.googleusercontent.com",
    "ALLOWED_ORIGINS": "https://parcelv.qgis.ge,http://localhost:8080"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "parcel-vertices",
      "database_id": "871c243d-a74c-4acb-b864-38cada061dd8",
      "migrations_dir": "migrations"
    }
  ]
}
