{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "parcel-vertices-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-16",
  "observability": {
    "enabled": true,
    "traces": { "enabled": true }
  },
  "vars": {
    // "mock" for local testing. Switch to "flitt" / "keepz" once an adapter exists.
    "PAYMENT_PROVIDER": "mock",
    "PUBLIC_BASE_URL": "http://localhost:8787",
    "ALLOWED_ORIGINS": "https://parcelv.qgis.ge,http://localhost:8080"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "parcel-vertices",
      // Replace with the real id from `wrangler d1 create parcel-vertices` before deploying.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
